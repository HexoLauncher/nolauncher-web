---
import { getCollection, render } from "astro:content";
import NewsLayout from "./NewsLayout.astro";
import NewsTags from "./NewsTags.astro";
import { locales, type Locale } from "../../i18n/landing";
import { newsStrings } from "../../i18n/news";
import { formatDate, newsUrl, tagsOf, type NewsEntry } from "../../lib/news";

interface Props {
  lang: Locale;
  entry: NewsEntry;
}

const { lang, entry } = Astro.props;
const n = newsStrings[lang];
const { Content } = await render(entry);


const slug = entry.id.split("/").slice(1).join("/");
const all = await getCollection("news");
const alternates: Partial<Record<Locale, string>> = {};
for (const key of Object.keys(locales) as Locale[]) {
  const other = all.find((e) => e.id === `${key}/${slug}` && !e.data.draft);
  if (other) alternates[key] = newsUrl(key, other);
}
---

<NewsLayout lang={lang} title={entry.data.title} description={entry.data.description} alternates={alternates}>
  <a class="news-back" href={`${locales[lang].path}news/`}>← {n.back}</a>
  <h1 class="legal-title news-title">{entry.data.title}</h1>
  <p class="legal-date">
    <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
  </p>
  <NewsTags tags={tagsOf(lang, entry)} />
  <article class="news-body">
    <Content />
  </article>
</NewsLayout>
